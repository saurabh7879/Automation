{
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/Profile(/.*)?$",     "dest": "/Profile/profile.html" },
    { "src": "^/WeatherChat(/.*)?$",    "dest": "/WeatherChat/index.html" },
    { "src": "^/InterviewPrep(/.*)?$", "dest": "/InterviewPrep/index.html" },
    { "src": ".*",                     "dest": "/404.html", "status": 404 }
  ]
}
